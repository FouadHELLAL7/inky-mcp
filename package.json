{
  "name": "inky-mcp",
  "version": "1.0.0",
  "description": "MCP server for the INKY email security External API: teams, usage, message search, threat statistics, reported mail, allow/block lists, VIPs and admins",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "inky-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prebuild": "node scripts/clean.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "start:http": "node scripts/run-with-env.mjs MCP_TRANSPORT=http -- node dist/index.js",
    "lint": "eslint src test scripts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-mcp.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke",
    "spec:fetch": "node scripts/fetch-openapi.mjs",
    "pack:mcpb": "node scripts/pack-mcpb.mjs"
  },
  "keywords": [
    "inky",
    "email-security",
    "phishing",
    "mcp",
    "msp",
    "security",
    "model-context-protocol"
  ],
  "author": "FouadHELLAL7",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FouadHELLAL7/inky-mcp.git"
  },
  "homepage": "https://github.com/FouadHELLAL7/inky-mcp#readme",
  "bugs": {
    "url": "https://github.com/FouadHELLAL7/inky-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
