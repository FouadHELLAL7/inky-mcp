# inky-mcp configuration. Placeholders only; never commit real values.

# --- INKY credentials (stdio, and HTTP when AUTH_MODE=env) -------------------
# Console-issued INKY API key (Settings -> API Keys). Starts with inky_ext_.
# Not read in AUTH_MODE=gateway; the gateway sends X-Inky-Api-Key per request.
INKY_API_KEY=

# Region of your INKY account: eu (https://api.eu.inkyphishfence.com) or
# us (https://api.inkyphishfence.com). A key only works in its own region.
# In gateway mode this is the default when a request has no X-Inky-Region header.
INKY_REGION=eu

# Optional alternative to INKY_REGION. Must be exactly one of the two origins above.
# INKY_API_BASE_URL=https://api.eu.inkyphishfence.com

# --- Transport -----------------------------------------------------------------
# stdio (default) or http
MCP_TRANSPORT=stdio

# HTTP only: env (INKY_API_KEY from the environment) or gateway
# (X-Inky-Api-Key required on every request; no environment fallback).
# AUTH_MODE=env

# HTTP only: required. The server refuses to start when empty or a known
# placeholder. Generate with: openssl rand -hex 32
CONDUIT_S2S_SECRET=

# Local development only: start HTTP without CONDUIT_S2S_SECRET (binds 127.0.0.1,
# does not check X-Gateway-S2S).
# MCP_ALLOW_INSECURE_DEV=1

# HTTP bind address and port (PORT is accepted as a fallback for MCP_HTTP_PORT).
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# --- Limits (defaults shown) -----------------------------------------------------
# INKY_TIMEOUT_MS=30000
# INKY_MAX_RETRIES=2
# INKY_MAX_RETRY_WAIT_SECONDS=30
# INKY_MAX_RESPONSE_BYTES=5242880
# INKY_MAX_OUTPUT_CHARS=60000
# INKY_ENABLE_RAW_REQUEST=true

# debug | info | warn | error (all logs go to stderr)
LOG_LEVEL=info
